SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SPRING_APPLICATION_NAME=healthmate-backend

SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
SPRING_DATA_MONGODB_DATABASE=healthmate

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

GEMINI_API_KEY=your-gemini-api-key

# Use at least 32 random characters.
JWT_SECRET=replace-this-with-a-strong-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Comma-separated list. Do not use '*' when allow-credentials is true.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://615915.xyz,https://healthmate-pj751oo5n-anujyadav2244.vercel.app,https://healthmate-01.vercel.app
